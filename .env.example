# Fear-Free Family Truth Companion - Environment Configuration
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_V1_PREFIX=/api/v1

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=fear_free_companion

# Ollama Local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=60

# File Storage & Limits
UPLOAD_DIRECTORY=./data/uploads
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=100
DOCUMENT_RETENTION_DAYS=30

# Authentication & Cookies
SESSION_TTL_HOURS=24
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_SECRET=change-this-to-a-secure-random-secret-in-production-min-32-chars

# SMTP / Mailer (Mailpit for local development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@fearfreecompanion.local
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# Worker Configuration
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_SECONDS=15
WORKER_MAX_RETRIES=3

# Cognee knowledge and retrieval service
COGNEE_API_URL=https://tenant-<your-tenant-id>.aws.cognee.ai
COGNEE_TENANT_ID=your_cognee_tenant_id

# n8n WhatsApp workflow (server-side only)
N8N_WHATSAPP_WEBHOOK_URL=https://your-n8n-domain/webhook/family-report-share
COGNEE_API_KEY=your_cognee_api_key
