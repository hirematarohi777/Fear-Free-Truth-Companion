# Fear-Free Family Truth Companion - Development Environment
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_V1_PREFIX=/api/v1

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=fear_free_companion

# Ollama Local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=60

# File Storage & Limits
UPLOAD_DIRECTORY=./data/uploads
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=100
DOCUMENT_RETENTION_DAYS=30

# Authentication & Cookies
SESSION_TTL_HOURS=24
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_SECRET=dev-secret-key-must-be-at-least-32-chars-long-for-fear-free-truth

# SMTP / Mailer (Mailpit for local development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@fearfreecompanion.local
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# Worker Configuration
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_SECONDS=15
WORKER_MAX_RETRIES=3


LLM_API_KEY = ""
LLM_BASE_URL=https://api.apinex.bond/v1
LLM_MODEL=claude/sonnet-5

# Cognee knowledge and retrieval service
COGNEE_API_URL=https://tenant-5b9108db-f3dd-4f16-960a-f65299fb5ea8.aws.cognee.ai
COGNEE_TENANT_ID=

# n8n WhatsApp workflow (server-side only)
N8N_WHATSAPP_WEBHOOK_URL=https://jasimk.app.n8n.cloud/webhook/family-report-share
COGNEE_API_KEY=
